{
  "manifest_version": 3,
  "name": "IndiaMART Supplier Scraper Pro",
  "version": "2.0.0",
  "description": "Enterprise-grade scraper — extracts name, phone, email, address & company details from IndiaMART suppliers. Exports to Excel.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://dir.indiamart.com/*",
    "https://www.indiamart.com/*",
    "https://indiamart.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dir.indiamart.com/*",
        "https://www.indiamart.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "xlsxgen.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
